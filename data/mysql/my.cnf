# =============================================================
# 绘梦 · 图书馆 MySQL 配置（容量上限 500G）
# 放置路径建议：/etc/mysql/conf.d/huimeng-library.cnf
# 功能：共享表空间按需自增长，最大 500G；独立表空间同样支持自动扩展。
# 注意：
#   MySQL 按需分配磁盘，不会一启动就占满 500G；
#   初次启动后可用 SELECT @@innodb_data_file_path 验证配置生效。
# =============================================================

[mysqld]
# ---------- 存储容量 ----------
# ibdata1 起始 12M，自动增长；总上限 500G
innodb_data_file_path = ibdata1:12M:autoextend:max:500G
# 每次扩展的步长（64M）
innodb_autoextend_increment = 64
# 每张表独立表空间，便于单独扩容 / 迁移
innodb_file_per_table = ON
# 单表空间文件上限（Windows 可设为 4G，Linux 可更大）
innodb_max_dedicated_server_doublewrite = ON
# 大文本页（书籍正文 MEDIUMTEXT）
innodb_page_size = 16K
# 日志文件，便于大量写入书籍数据
innodb_log_file_size = 512M
innodb_log_buffer_size = 64M
innodb_buffer_pool_size = 1G

# ---------- 字符集 ----------
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# ---------- 网络 ----------
bind-address = 0.0.0.0
port = 3306
max_connections = 200
max_allowed_packet = 64M

# ---------- 其它 ----------
default-time-zone = '+08:00'
sql_mode = STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION

[client]
default-character-set = utf8mb4
